# Local database / dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secure_sdlc?schema=public"

APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ---- Production (docker-compose.prod.yml) ----------------------------------
# Public domain served by Caddy (auto HTTPS). e.g. "fuse.example.com".
DOMAIN="localhost"
# Auth.js must trust the reverse proxy host; Caddy forwards X-Forwarded-*.
AUTH_TRUST_HOST="true"
# Trust X-Forwarded-For from the reverse proxy (rate limiting / audit IPs).
TRUSTED_PROXY="1"
# Postgres password used by the prod compose stack (use a strong value).
POSTGRES_PASSWORD="change-me-strong-password"
# ----------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth (optional - app works without it in dev mode)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""

# AI Provider configuration
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_MODEL="gemini-flash-latest"
DEFAULT_AI_API_KEY=""

# Runner/tooling mode: "local-docker" (default) runs Run & security scans in
# Docker containers. Set to "disabled" on hosts without a Docker daemon
# (e.g. serverless platforms, or the public prod stack) to skip those features.
RUNNER_MODE="local-docker"

# Interface on which generated-app and database ports are published. Defaults
# to loopback so a generated app is not reachable from the LAN/internet. Set to
# "0.0.0.0" when users on other devices must open/preview the generated app
# (the preview URL then uses the browser's hostname); pair it with a firewall or
# reverse proxy. Use "127.0.0.1" for single-machine use.
RUNNER_BIND_HOST="127.0.0.1"
# Max concurrent generated-app containers per user and overall (DoS guard).
RUNNER_MAX_RUNS_PER_USER="2"
RUNNER_MAX_RUNS_TOTAL="6"
# Minutes a run is kept alive while idle before it is auto-stopped.
RUN_TTL_MINUTES="60"
