        {
          "id": "cart",
          "url": "https://gocart-gs.vercel.app/product/prod_1",
          "actions": [
            { "do": "click", "selector": "button:has-text('Claim Offer') + button", "optional": true },
            { "do": "click", "selector": "button:has-text('Add to Cart')" },
            { "do": "click", "selector": "a[href='/cart']" },
            { "do": "wait", "ms": 1500 }
          ]
        },
        { "id": "orders", "url": "https://gocart-gs.vercel.app/orders", "actions": [{ "do": "click", "selector": "button:has-text('Claim Offer') + button", "optional": true }] },
